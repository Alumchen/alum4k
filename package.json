{
  "name": "alum4k",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/site.test.ts tests/windows.test.ts tests/xinsj.test.ts tests/ai.test.ts tests/collector.test.mjs",
    "collect:windows": "node --import tsx scripts/import-windows.ts",
    "test:collector": "node --test tests/collector.test.mjs",
    "collect:115": "node scripts/115-collector/collect.mjs",
    "collect:115:login": "node scripts/115-collector/login.mjs",
    "collect:115:sync": "node scripts/115-collector/collect.mjs --sync",
    "collect:115:backfill": "node scripts/115-collector/collect.mjs --sync --backfill",
    "test:ui": "node --import tsx tests/ui.ts",
    "test:workbench": "node --import tsx tests/workbench-ui.ts",
    "test:windows": "node --import tsx tests/windows-ui.ts",
    "test:xinsj": "node --import tsx tests/xinsj-ui.ts",
    "test:ai": "node --import tsx tests/ai-ui.ts",
    "test:ai-relay": "node --import tsx tests/ai-relay-ui.ts",
    "test:ai-adapter": "node --import tsx tests/ai-adapter-ui.ts",
    "test:production": "npm run build && node --import tsx tests/production-ui.ts",
    "preview": "vite preview --host 0.0.0.0",
    "serve:api": "tsx server/index.ts",
    "start": "npm run serve:api"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@novnc/novnc": "1.5.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.2",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "http-proxy": "^1.18.1",
    "https-proxy-agent": "^9.1.0",
    "image-size": "^2.0.4",
    "lucide-react": "^0.468.0",
    "parse-torrent": "^11.0.24",
    "parse5": "^7.2.1",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.19.0",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/http-proxy": "^1.17.16",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.5.4",
    "ws": "^8.21.0"
  }
}
