# TMDB: 二选一即可，推荐 Bearer Token。密钥只在服务端使用，浏览器不会看到。
TMDB_BEARER_TOKEN=
TMDB_API_KEY=

# TMDB 图片的同站点磁盘缓存上限（MB），默认 256，范围 32-2048。
TMDB_IMAGE_CACHE_MB=256

# API 服务端口
API_PORT=5174

# 本站仅提供 115 网盘和磁力下载链接，不再使用 AList 在线播放配置。

# 如果你的网络访问 TMDB 需要代理，可以配置本机代理。
HTTPS_PROXY=
HTTP_PROXY=

# 本地账号系统
ADMIN_PASSWORD=admin123456
AUTH_SECRET=please-change-this-secret
