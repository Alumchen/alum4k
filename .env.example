# TMDB: 二选一即可，推荐 Bearer Token。密钥只在服务端使用，浏览器不会看到。
TMDB_BEARER_TOKEN=
TMDB_API_KEY=

# API 服务端口
API_PORT=5174

# AList/OpenList：VIP 在线观看 115 文件时使用。
# 后台 115 资源地址请填写 AList 文件路径，例如 /电影/片名.mkv。
ALIST_BASE_URL=
ALIST_TOKEN=

# 如果你的网络访问 TMDB 需要代理，可以配置本机代理。
HTTPS_PROXY=
HTTP_PROXY=

# 本地账号系统
ADMIN_PASSWORD=admin123456
AUTH_SECRET=please-change-this-secret
